generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                String                 @id
  name              String
  domain            String
  environment       String                 @default("production")
  defaultCurrency   String                 @default("INR")
  timezone          String                 @default("UTC")
  razorpayKeyId     String
  razorpaySecretRef String
  status            String                 @default("ACTIVE")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  economics         MerchantEconomics?
  paymentAttempts   PaymentAttempt[]
  paymentEvents     PaymentEvent[]
  webhookEvents     RazorpayWebhookEvent[]
  riskEvents        RiskEvent[]

  @@map("merchants")
}

model MerchantEconomics {
  id                       String   @id @default(uuid())
  merchantId               String   @unique
  defaultMarginRate        Float    @default(0.20)
  categoryEconomics        Json?
  minimumRecoveryThreshold Float    @default(0.0)
  maxRecoveryCost          Float    @default(0.0)
  version                  Int      @default(1)
  updatedAt                DateTime @updatedAt
  baseRecoveryCost         Float    @default(5.0)
  merchant                 Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_economics")
}

model PaymentAttempt {
  id                        String         @id
  merchantId                String
  customerId                String?
  sessionId                 String?
  merchantOrderId           String
  razorpayOrderId           String?
  razorpayPaymentId         String?
  amount                    Float
  currency                  String         @default("INR")
  providerState             String         @default("CREATED")
  businessState             String         @default("UNRESOLVED")
  revenueObligationResolved Boolean        @default(false)
  startedAt                 DateTime       @default(now())
  resolvedAt                DateTime?
  expiresAt                 DateTime
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  customerSegment           String?
  customerValueSegment      String?
  historicalLtv             Float?
  orderCategory             String?
  merchant                  Merchant       @relation(fields: [merchantId], references: [id])
  paymentEvents             PaymentEvent[]

  @@index([merchantId, merchantOrderId])
  @@index([merchantId, customerId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("payment_attempts")
}

model PaymentEvent {
  id               String         @id @default(uuid())
  paymentAttemptId String
  merchantId       String
  eventType        String
  source           String
  payload          Json
  occurredAt       DateTime
  receivedAt       DateTime       @default(now())
  correlationId    String?
  merchant         Merchant       @relation(fields: [merchantId], references: [id])
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@index([paymentAttemptId])
  @@index([merchantId])
  @@map("payment_events")
}

model RazorpayWebhookEvent {
  id              String    @id @default(uuid())
  razorpayEventId String    @unique
  merchantId      String
  eventType       String
  paymentId       String?
  orderId         String?
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  status          String    @default("PENDING")
  merchant        Merchant  @relation(fields: [merchantId], references: [id])

  @@map("razorpay_webhook_events")
}

model RiskEvent {
  id                    String    @id @default(uuid())
  paymentAttemptId      String
  merchantId            String
  eventType             String    @default("PAYMENT_FAILURE_RISK")
  payload               Json
  emittedAt             DateTime  @default(now())
  attemptCount          Int       @default(0)
  processingStatus      String    @default("PENDING")
  validationCompletedAt DateTime?
  validationStartedAt   DateTime?
  version               Int       @default(1)
  processingLeaseUntil  DateTime?
  merchant              Merchant  @relation(fields: [merchantId], references: [id])

  @@index([paymentAttemptId])
  @@index([merchantId])
  @@index([processingStatus])
  @@map("risk_events")
}

model RevenueObligation {
  id                          String    @id @default(uuid())
  merchantId                  String
  merchantOrderId             String
  amount                      Float
  currency                    String
  status                      String    @default("UNRESOLVED")
  successfulPaymentAttemptId  String?
  successfulRazorpayPaymentId String?
  resolvedAt                  DateTime?
  version                     Int       @default(1)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@unique([merchantId, merchantOrderId])
  @@index([merchantId, status])
  @@map("revenue_obligations")
}

model ValidationResult {
  id                    String   @id @default(uuid())
  riskEventId           String   @unique
  paymentAttemptId      String
  merchantId            String
  diagnosedCause        String?
  diagnosisConfidence   Float?
  actionabilityScore    Float?
  actionabilityStatus   String?
  priority              String?
  revenueAtRisk         Float?
  economicFactor        Float?
  recoveryProbability   Float?
  recoveryCost          Float?
  expectedRecoveryValue Float?
  netExpectedRecovery   Float?
  decision              String?
  stopReason            String?
  evidence              Json?
  correlationId         String?
  rulesVersion          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([merchantId])
  @@map("validation_results")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String    @map("event_type")
  aggregateId String?   @map("aggregate_id")
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@map("outbox_events")
}
